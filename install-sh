#!/bin/sh
LANG_SHORT=${LANG%%_*}
[ -z "$LANG_SHORT" ] && LANG_SHORT='en'
msg () {
    correct='./install-sh [--python | --sh-posix]'
    case "$LANG_SHORT" in
        es)
        case "$1" in
            option) printf "Seleccione la versión o \033[1mC\033[0m para cancelar: " ;;
            0) printf "\033[1m¡Instalado correctamente!\033[0m\n" ;;
            1) printf 'Instalación cancelada.\n' ;;
            2) printf 'Uso incorrecto. %s\n' "$correct" ;;
            3) printf 'Opción incorrecta. %s\n' "$correct" ;;
            4) printf 'Ejecute \033[7mrehash\033[0m o reinicie la terminal.\n' ;;
            5) printf 'Error durante la copia del archivo.\n' ;;
        esac ;;
        *)
        case "$1" in
            option) printf "Choose a version or \033[1mC\033[0m to cancel: " ;;
            0) printf "\033[1mSuccessfully installed!\033[0m\n" ;;
            1) printf 'Installation cancelled.\n' ;;
            2) printf 'Invalid usage. %s\n' "$correct" ;;
            3) printf 'Incorrect option. %s\n' "$correct" ;;
            4) printf 'Run \033[7mrehash\033[0m or restart the terminal.\n' ;;
            5) printf 'Error copying file.\n' ;;
        esac ;;
    esac
    case "$1" in
        option|0|1) [ -n "$2" ] && exit $1 ;;
        4) exit 0 ;;
        *) exit $1 ;;
    esac
}

o=''
OPTION="${1:-}"

case "$#" in
    0)
    while [ -z "$o" ]; do
        printf '\033[1m1\033[0m.- Python\n'
        printf '\033[1m2\033[0m.- Shell (POSIX)\n'
        msg option
        IFS= read -r o || msg 1 aux
        case "$o" in
            1) OPTION='--python' ;;
            2) OPTION='--sh-posix' ;;
            C|c) msg 1; exit 0 ;;
            *) o='' ;;
        esac
    done
;;
    1) ;;
    *) msg 2 ;;
esac

case "$OPTION" in
    -py|--python) file='apt_trixie.py' ;;
    -sh|--sh-posix) file='apt_trixie.sh' ;;
    *) msg 3 ;;
esac

if [ "$(id -u)" -gt 0 ]; then
    copy_cmd='sudo cp'
    chmod_cmd='sudo chmod'
fi
to='/usr/local/bin/apt'

if [ "$(id -u)" -eq 0 ]; then
    cp "$file" "$to" && chmod +x "$to"
    ret="$?"
else
    sudo sh -c "cp '$file' '$to' && chmod +x '$to'"
    ret="$?"
fi
if [ "$ret" -eq 0 ]; then
    msg 0
    hash -r
else
    msg 5
fi
